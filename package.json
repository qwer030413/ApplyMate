{
  "name": "applymate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader runner",
    "preview": "vite preview --host 127.0.0.1 --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner && node scripts/build-extension.mjs",
