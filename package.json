    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/archiver": "^7.0.0",
    "@types/chrome": "^0.0.312",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "archiver": "^7.0.1",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.7",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
